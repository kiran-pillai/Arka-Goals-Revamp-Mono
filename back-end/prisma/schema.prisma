// Prisma schema for arka-goals-revamp — invitation-only magic-link auth.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The `citext` extension (for case-insensitive email columns) and the
  // partial unique index on pending invites are created in the migration SQL.
}

enum Role {
  MEMBER
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TokenPurpose {
  LOGIN
  INVITE
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique @db.Citext
  role        Role      @default(MEMBER)
  firstName   String?
  lastName    String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  colorSlot   Int?

  invitesSent Invite[]  @relation("InvitedBy")
  checkIns    CheckIn[]
  goals       Goal[]
  comments    Comment[]
}

model CheckIn {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedGoal Boolean
  results       String
  commitments   String
  wins          String
  frictions     String
  rating        Int
  createdAt     DateTime @default(now())
  comments      Comment[]

  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  checkInId String
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([checkInId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(uuid())
  email       String       @db.Citext
  role        Role         @default(MEMBER)
  firstName   String?
  lastName    String?
  status      InviteStatus @default(PENDING)
  invitedById String?
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  // A partial unique index (one PENDING invite per email) is added in the
  // migration SQL — Prisma can't express `WHERE status = 'PENDING'` here.
  @@index([email])
}

enum GoalType {
  WEEKLY
  QUARTERLY
}

enum MeasureType {
  ACTION_BASED
  PASS_FAIL
}

enum GoalPeriodChoice {
  QUARTERLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model Goal {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        GoalType
  measureType MeasureType
  title       String
  description String          @default("")
  targetValue Int?
  currentValue Int            @default(0)
  status      GoalStatus      @default(ACTIVE)
  periodChoice GoalPeriodChoice?
  dueDate     DateTime?
  lockedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model MagicLinkToken {
  id         String       @id @default(uuid())
  tokenHash  String       @unique
  email      String       @db.Citext
  purpose    TokenPurpose @default(LOGIN)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([email])
  @@index([expiresAt])
}
