// Prisma schema for arka-goals-revamp — invitation-only magic-link auth.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The `citext` extension (for case-insensitive email columns) and the
  // partial unique index on pending invites are created in the migration SQL.
}

enum Role {
  MEMBER
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TokenPurpose {
  LOGIN
  INVITE
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique @db.Citext
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  invitesSent Invite[] @relation("InvitedBy")
}

model Invite {
  id          String       @id @default(uuid())
  email       String       @db.Citext
  role        Role         @default(MEMBER)
  status      InviteStatus @default(PENDING)
  invitedById String?
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  // A partial unique index (one PENDING invite per email) is added in the
  // migration SQL — Prisma can't express `WHERE status = 'PENDING'` here.
  @@index([email])
}

model MagicLinkToken {
  id         String       @id @default(uuid())
  tokenHash  String       @unique
  email      String       @db.Citext
  purpose    TokenPurpose @default(LOGIN)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([email])
  @@index([expiresAt])
}
