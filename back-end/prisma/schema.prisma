// Prisma schema for arka-goals-revamp — invitation-only magic-link auth.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The `citext` extension (for case-insensitive email columns) and the
  // partial unique index on pending invites are created in the migration SQL.
}

enum Role {
  MEMBER
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TokenPurpose {
  LOGIN
  INVITE
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique @db.Citext
  role        Role      @default(MEMBER)
  firstName   String?
  lastName    String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  colorSlot   Int?

  invitesSent Invite[]  @relation("InvitedBy")
  checkIns    CheckIn[]
  goals       Goal[]
  comments    Comment[]
}

model CheckIn {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedGoal Boolean
  results       String
  commitments   String
  wins          String
  frictions     String
  rating        Int
  createdAt     DateTime @default(now())
  comments      Comment[]

  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  checkInId String
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([checkInId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(uuid())
  email       String       @db.Citext
  role        Role         @default(MEMBER)
  firstName   String?
  lastName    String?
  status      InviteStatus @default(PENDING)
  invitedById String?
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  // A partial unique index (one PENDING invite per email) is added in the
  // migration SQL — Prisma can't express `WHERE status = 'PENDING'` here.
  @@index([email])
}

enum GoalType {
  WEEKLY
  QUARTERLY
}

// A goal is exactly one of these two kinds. A HABIT_PROCESS goal is measured by
// how often it repeats (see `frequencyCount` / `frequencyPeriod`); an OUTCOME
// goal is measured by whether the result was hit.
enum MeasureType {
  HABIT_PROCESS
  OUTCOME
}

enum FrequencyPeriod {
  DAY
  WEEK
  MONTH
  QUARTER
}

enum GoalPeriodChoice {
  QUARTERLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model Goal {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        GoalType
  measureType MeasureType
  title       String
  description String          @default("")
  // Only OUTCOME goals may carry a targetValue; only HABIT_PROCESS goals may
  // carry a frequency, and they must carry both halves of it. A CHECK
  // constraint enforcing that shape is added in the migration SQL — Prisma
  // can't express a cross-column constraint here.
  //
  // Goal creation no longer collects a targetValue, so new rows are always
  // NULL here. The column is retained because rows migrated from the old
  // ACTION_BASED kind still carry their target numbers, and that is how a
  // quantified outcome stays distinguishable from a pass/fail one. The update
  // path can also still set one on an OUTCOME goal.
  targetValue Int?
  frequencyCount Int?
  frequencyPeriod FrequencyPeriod?
  currentValue Int            @default(0)
  status      GoalStatus      @default(ACTIVE)
  periodChoice GoalPeriodChoice?
  dueDate     DateTime?
  lockedAt    DateTime?
  // When this goal was marked COMPLETED. The server derives it from the status
  // transition — it is never accepted from a client — and clears it again when
  // a goal is reopened, so it can't hold a stale completion date. `updatedAt`
  // can't answer this question because any later edit overwrites it.
  //
  // NULL means "no recorded completion time", which includes goals already at
  // COMPLETED before this column existed.
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model MagicLinkToken {
  id         String       @id @default(uuid())
  tokenHash  String       @unique
  email      String       @db.Citext
  purpose    TokenPurpose @default(LOGIN)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([email])
  @@index([expiresAt])
}
